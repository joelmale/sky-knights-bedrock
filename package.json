{
  "name": "sky-knights-bedrock",
  "version": "0.3.1",
  "productName": "Sky Knights: Bedrock",
  "description": "Minecraft Bedrock add-on inspired by the Sky Knights game.",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "node tools/project.mjs lint",
    "lint:fix": "node tools/project.mjs lint --fix",
    "build": "node tools/project.mjs build",
    "build:production": "node tools/project.mjs build --production",
    "build:profiles": "node tools/build-profile.mjs --all",
    "build:experimental": "node tools/build-profile.mjs --profile experimental",
    "build:gametest": "node tools/build-profile.mjs --profile gametest",
    "clean": "node tools/project.mjs clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:bds:unit": "node tools/bds/test-nbt.mjs",
    "test:bds:smoke": "npm run test:bds:unit && node tools/bds/run-smoke.mjs",
    "check": "npm run lint && npm run build && npm test",
    "local-deploy": "node tools/project.mjs local-deploy",
    "local-deploy:experimental": "node tools/build-profile.mjs --profile experimental --deploy",
    "local-deploy:gametest": "node tools/build-profile.mjs --profile gametest --deploy",
    "mcaddon": "node tools/project.mjs mcaddon",
    "mcaddon:production": "node tools/project.mjs mcaddon --production",
    "structures:generate": "node tools/generate-structures.mjs",
    "structures:check": "node tools/generate-structures.mjs --check",
    "world-template": "npm run build && node tools/package-world-template.mjs",
    "verify": "npm run structures:check && npm run check && npm run test:bds:unit && npm run mcaddon:production && npm run build:profiles",
    "enablemcloopback": "CheckNetIsolation.exe LoopbackExempt -a -p=S-1-15-2-1958404141-86561845-1752920682-3514627264-368642714-62675701-733520436",
    "enablemcpreviewloopback": "CheckNetIsolation.exe LoopbackExempt -a -p=S-1-15-2-424268864-5579737-879501358-346833251-474568803-887069379-4040235476"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  },
  "dependencies": {
    "@minecraft/math": "2.2.11",
    "@minecraft/server": "2.8.0",
    "@minecraft/server-ui": "2.1.0",
    "@minecraft/vanilla-data": "1.26.33"
  },
  "devDependencies": {
    "@minecraft/server-gametest": "1.0.0-beta.1.26.33-stable",
    "esbuild": "0.28.1",
    "fflate": "0.8.3",
    "prettier": "3.9.6",
    "typescript": "5.5.4",
    "vitest": "4.1.10"
  }
}
